# Production regular variables.
# Real values go in .env.production.vars (gitignored).
# Every key listed in this example is required by npm run env:check:prod.
# If a value is intentionally optional/fallback, remove that key from this example.
# You may still keep optional configured values in .env.production.vars.

VITE_SITE_URL=https://hotel-lobby-ai.pro
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

CLOUDCONVERT_SOUNDTRACK_URL=https://cdn.hotel-lobby-ai.pro/sound/soundtrack_15.mp3

R2_ACCOUNT_ID=
R2_BUCKET_NAME=hotel-lobby-ai
R2_PUBLIC_BASE_URL=https://cdn.hotel-lobby-ai.pro

PAYMENT_PROVIDER=waffo
WAFFO_ENVIRONMENT=prod
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_GENERATION_480P_PRODUCT_ID=
WAFFO_GENERATION_720P_PRODUCT_ID=
WAFFO_GENERATION_1080P_PRODUCT_ID=

ENABLE_IMAGE_MODERATION=true
MOCK_GENERATION=false
