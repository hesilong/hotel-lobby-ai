{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotel-lobby-ai",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "keep_vars": true,
  "r2_buckets": [
    {
      "binding": "AI_MEDIA_BUCKET",
      "bucket_name": "hotel-lobby-ai",
      "remote": true
    }
  ],
  "triggers": {
    "crons": ["*/2 * * * *"]
  }
}
