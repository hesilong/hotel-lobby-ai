# Production secrets.
# Real values go in .env.production.secrets (gitignored).
# Never put real secret values in this example file.
# Every key listed here is required by npm run env:check:prod.
# If a secret is intentionally optional/fallback, remove that key from this example.

SUPABASE_SERVICE_ROLE_KEY=
KIE_API_KEY=
CLOUDCONVERT_API_KEY=

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

WAFFO_PRIVATE_KEY=

# Prompt moderation uses CREEM while image moderation uses SeeAPI.
CREEM_API_KEY=
SEEAPI_API_KEY=
