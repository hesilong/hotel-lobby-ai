# Waffo Production product setup only.
# Copy to .env.waffo-prod and fill the private values locally.
WAFFO_ENVIRONMENT=prod
WAFFO_CONFIRM_PRODUCTION=CREATE

WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=

# Set one of these, not both.
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_BASE64=

# Optional: leave empty on first run so the script creates the products.
# If already created, set the IDs here and the script will synchronize them.
WAFFO_GENERATION_480P_PRODUCT_ID=
WAFFO_GENERATION_720P_PRODUCT_ID=
WAFFO_GENERATION_1080P_PRODUCT_ID=
