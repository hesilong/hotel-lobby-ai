VITE_SITE_URL=https://hotel-lobby-ai.pro
VITE_GA4_MEASUREMENT_ID=G-QRGEK14KFY
VITE_CLARITY_PROJECT_ID=yqmsv0u4fd
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Review mode hides the public demo from the empty result panel.
# true: hide demo, keep a neutral empty state
# false: show the demo before the user's first generation
VITE_REVIEW_MODE=false

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

KIE_API_BASE_URL=https://api.kie.ai
KIE_API_KEY=
# Optional explicit callback URL. Leave empty in local development unless using an HTTPS tunnel.
# Production falls back to VITE_SITE_URL + /api/kie/callback.
KIE_CALLBACK_URL=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=hotel-lobby-ai
R2_PUBLIC_BASE_URL=https://cdn.hotel-lobby-ai.pro
# Optional dedicated HMAC secret for guest upload capability tokens.
# If empty, R2_SECRET_ACCESS_KEY is used.
ASSET_TOKEN_SECRET=

# CREEM billing + required prompt moderation
PAYMENT_PROVIDER=creem
# Waffo is server-side only. Never use a VITE_ prefix for private keys.
WAFFO_ENVIRONMENT=test
WAFFO_MERCHANT_ID=MER_3P0D3zzqjx5NUluHyA3Ywb
WAFFO_STORE_ID=STO_50KaSJgcSUv1UX5Kz7WpQi
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_BASE64=
# Optional ngrok/preview URL used by scripts/setup-waffo.ts to register test callbacks.
WAFFO_WEBHOOK_URL=https://hotel-lobby-ai.pro/api/waffo/webhook
WAFFO_PRO_MONTHLY_PRODUCT_ID=
WAFFO_PRO_YEARLY_PRODUCT_ID=
WAFFO_ULTIMATE_MONTHLY_PRODUCT_ID=
WAFFO_ULTIMATE_YEARLY_PRODUCT_ID=
WAFFO_CREDIT_PACK_STARTER_PRODUCT_ID=
WAFFO_CREDIT_PACK_CREATOR_PRODUCT_ID=
WAFFO_CREDIT_PACK_STUDIO_PRODUCT_ID=

CREEM_API_URL=https://api.creem.io
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_MODERATION_ENABLED=true
CREEM_MODERATION_BLOCK_FLAG=true
CREEM_MODERATION_FAIL_OPEN=false

# Override these if Hotel Lobby AI uses its own CREEM products.
CREEM_PRO_MONTHLY_PRODUCT_ID=
CREEM_PRO_YEARLY_PRODUCT_ID=
CREEM_ULTIMATE_MONTHLY_PRODUCT_ID=
CREEM_ULTIMATE_YEARLY_PRODUCT_ID=
CREEM_CREDIT_PACK_STARTER_PRODUCT_ID=
CREEM_CREDIT_PACK_CREATOR_PRODUCT_ID=
CREEM_CREDIT_PACK_STUDIO_PRODUCT_ID=

# Reference-image moderation
ENABLE_IMAGE_MODERATION=true
SEEAPI_API_KEY=


# Temporary production bridge while CREEM review is pending.
# true: Generate redirects to ClothMotion with a temporary handoff token.
# false: Generate uses this site's local billing + generation pipeline.
GENERATION_HANDOFF_TO_CLOTHMOTION=true
# Production: https://www.clothmotion.app/hotel-lobby-ai
# Local example: http://localhost:3000/hotel-lobby-ai
CLOTHMOTION_HANDOFF_URL=https://www.clothmotion.app/hotel-lobby-ai

# Safe local/test mode. When true, no KIE request is made.
# The task stays processing until Cron advances it through the normal
# provider-success and R2 persistence flow.
MOCK_GENERATION=false
# Optional mock result video. Defaults to a Hotel Lobby preview video.
MOCK_RESULT_VIDEO_URL=
# Test-only failure injection. Effective only while MOCK_GENERATION=true.
# true: force generated-video R2 persistence to fail and exercise fallback.
MOCK_R2_FAILURE=false


# CREEM webhook endpoint after deployment:
# https://hotel-lobby-ai.pro/api/creem/webhook
